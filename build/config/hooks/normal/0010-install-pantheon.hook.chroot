#!/bin/sh
set -e
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends gnupg ca-certificates curl
curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&exact=on&search=0x364837CF91E070910231C2FE8219B3A0AEF3D498" | gpg --dearmor -o /etc/apt/trusted.gpg.d/elementary-os.gpg
echo "deb https://ppa.launchpadcontent.net/elementary-os/stable/ubuntu noble main" > /etc/apt/sources.list.d/elementary-os-stable.list
apt-get update
apt-get install -y --no-install-recommends elementary-desktop elementary-live
apt-get install -y --no-install-recommends plymouth-theme-elementary
