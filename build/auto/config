#!/bin/sh
set -e
lb config noauto \
  --distribution noble \
  --archive-areas "main restricted universe multiverse" \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --linux-flavours generic \
  --debian-installer none \
  --iso-application "CodexyyOS" \
  --iso-volume "CODEXYYOS" \
  --iso-publisher "codexyy.dev" \
  --bootappend-live "boot=live components quiet splash username=codexyy hostname=codexyyos console=ttyS0" \
  --memtest none \
  "${@}"
